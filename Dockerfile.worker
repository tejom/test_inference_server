FROM rust:1-bookworm AS build
WORKDIR /app
COPY rust-port/ ./
RUN cargo build --release --locked --bin llama2-rs

FROM debian:bookworm-slim
COPY --from=build /app/target/release/llama2-rs /usr/local/bin/llama2-rs
COPY stories15M.bin tokenizer.bin /models/
EXPOSE 8080
CMD ["llama2-rs", "/models/stories15M.bin", "-z", "/models/tokenizer.bin", "-m", "server", "-H", "0.0.0.0", "-P", "8080", "-n", "128"]
